{
  "info": {
    "name": "Fake API Local QA Automation",
    "_postman_id": "9baf3a2d-8d11-44e0-b123-qaautomation",
    "description": "Collection completa para automação da Fake API com JSON Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "fakeApiUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],

  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time < 2000ms', function () {",
          "   pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",

          "pm.test('Status code is not 500', function () {",
          "   pm.expect(pm.response.code).to.not.eql(500);",
          "});",

          "console.log('STATUS:', pm.response.code);",
          "console.log('TIME:', pm.response.responseTime);"
        ]
      }
    }
  ],

  "item": [

    {
      "name": "AUTH",

      "item": [

        {
          "name": "Register User",

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 400', function () {",
                  "   pm.expect(pm.response.code).to.be.oneOf([201,400]);",
                  "});"
                ]
              }
            }
          ],

          "request": {
            "method": "POST",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/register",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },

        {
          "name": "Login Success",

          "event": [
            {
              "listen": "test",

              "script": {
                "type": "text/javascript",

                "exec": [
                  "const response = pm.response.json();",

                  "pm.collectionVariables.set('accessToken', response.accessToken);",

                  "pm.test('Status code is 200', function () {",
                  "   pm.response.to.have.status(200);",
                  "});",

                  "pm.test('Access token exists', function () {",
                  "   pm.expect(response.accessToken).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],

          "request": {
            "method": "POST",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/login",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },

        {
          "name": "Login Invalid",

          "event": [
            {
              "listen": "test",

              "script": {
                "type": "text/javascript",

                "exec": [
                  "pm.test('Status code is 400 or 401', function () {",
                  "   pm.expect(pm.response.code).to.be.oneOf([400,401]);",
                  "});"
                ]
              }
            }
          ],

          "request": {
            "method": "POST",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"wrongpass\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/login",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        }
      ]
    },

    {
      "name": "BOOKINGS",

      "item": [

        {
          "name": "Get All Bookings",

          "request": {
            "method": "GET",

            "url": {
              "raw": "{{fakeApiUrl}}/bookings",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings"
              ]
            }
          },

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ]
        },

        {
          "name": "Create Booking",

          "event": [
            {
              "listen": "test",

              "script": {
                "type": "text/javascript",

                "exec": [
                  "const response = pm.response.json();",

                  "pm.collectionVariables.set('bookingId', response.id);",

                  "pm.test('Status code is 201', function () {",
                  "   pm.response.to.have.status(201);",
                  "});",

                  "pm.test('Booking ID exists', function () {",
                  "   pm.expect(response.id).to.not.be.null;",
                  "});",

                  "pm.test('Firstname is Maria', function () {",
                  "   pm.expect(response.firstname).to.eql('Maria');",
                  "});"
                ]
              }
            }
          ],

          "request": {
            "method": "POST",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Maria\",\n  \"lastname\": \"QA\",\n  \"totalprice\": 700,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-07-01\",\n    \"checkout\": \"2026-07-10\"\n  },\n  \"additionalneeds\": \"Lunch\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/bookings",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings"
              ]
            }
          }
        },

        {
          "name": "Get Booking By ID",

          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookingId = pm.collectionVariables.get('bookingId');",

                  "if (!bookingId) {",
                  "   throw new Error('bookingId não encontrado. Execute Create Booking primeiro.');",
                  "}"
                ]
              }
            },

            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ],

          "request": {
            "method": "GET",

            "url": {
              "raw": "{{fakeApiUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          }
        },

        {
          "name": "Update Booking",

          "request": {
            "method": "PUT",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Maria Updated\",\n  \"lastname\": \"Automation\",\n  \"totalprice\": 900,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-08-01\",\n    \"checkout\": \"2026-08-20\"\n  },\n  \"additionalneeds\": \"Dinner\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          },

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",

                  "pm.response.to.have.status(200);",

                  "pm.expect(response.firstname).to.eql('Maria Updated');"
                ]
              }
            }
          ]
        },

        {
          "name": "Patch Booking",

          "request": {
            "method": "PATCH",

            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Maria PATCH\"\n}"
            },

            "url": {
              "raw": "{{fakeApiUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          },

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",

                  "pm.response.to.have.status(200);",

                  "pm.expect(response.firstname).to.eql('Maria PATCH');"
                ]
              }
            }
          ]
        },

        {
          "name": "Delete Booking",

          "request": {
            "method": "DELETE",

            "url": {
              "raw": "{{fakeApiUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{fakeApiUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          },

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",

                  "pm.collectionVariables.unset('bookingId');"
                ]
              }
            }
          ]
        }
      ]
    },

